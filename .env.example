# === SkyRoutes — пример конфигурации ===
# Скопируй в .env и подставь свои значения.

# Название и версия приложения
TRAVEL_APP_NAME="SkyRoutes — Путешествия и Авиаперелёты"
TRAVEL_APP_VERSION="0.2.0"
TRAVEL_DEBUG=True

# База данных (по умолчанию — SQLite в корне проекта)
TRAVEL_DATABASE_URL=sqlite+aiosqlite:///./travel.db
# Для продакшена:
# TRAVEL_DATABASE_URL=postgresql+asyncpg://user:password@localhost:5432/skyroutes

# Валюта и пагинация
TRAVEL_CURRENCY=RUB
TRAVEL_CURRENCY_SYMBOL=₽
TRAVEL_PAGE_SIZE=10

# JWT-настройки — ОБЯЗАТЕЛЬНО поменяй secret_key в продакшене
# Сгенерировать длинный ключ: python -c "import secrets; print(secrets.token_urlsafe(48))"
TRAVEL_SECRET_KEY=change-me-in-production-please-use-long-random-string
TRAVEL_JWT_ALGORITHM=HS256
TRAVEL_ACCESS_TOKEN_EXPIRE_MINUTES=1440
